+            end
+            DECIDE:if(decision_done)begin target<=decision_accept;state<=FINISH;end
+            FINISH:begin busy<=0;done<=1;valid_result<=1;state<=IDLE;end
+            default:begin state<=IDLE;busy<=0;end
+            endcase
+        end
+    end
+endmodule
